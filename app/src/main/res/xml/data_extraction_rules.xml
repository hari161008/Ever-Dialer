<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
         Bug fix: an empty <cloud-backup>/<device-transfer> block backs up EVERYTHING by default,
         including the call recorder's private-storage folder (files/call_recordings/). That let a
         recording the user had already deleted come back after reinstalling the app or restoring
         to a new device from a stale backup snapshot, making deletion look like it "doesn't work".
         Excluded explicitly so recordings only ever exist where the user currently has them.
    -->
    <cloud-backup>
        <exclude domain="file" path="call_recordings/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="call_recordings/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>